* {
    primary: #ffffff;
    primary-fixed: #e0e0e0;
    primary-fixed-dim: #e0e0e0;
    on-primary: #000000;
    on-primary-fixed: #000000;
    on-primary-fixed-variant: #000000;
    primary-container: #e0e0e0;
    on-primary-container: #000000;
    secondary: #ffffff;
    secondary-fixed: #ffffff;
    secondary-fixed-dim: #ffffff;
    on-secondary: #000000;
    on-secondary-fixed: #000000;
    on-secondary-fixed-variant: #000000;
    secondary-container: #ffffff;
    on-secondary-container: #000000;
    tertiary: #cccccc;
    tertiary-fixed: #e0e0e0;
    tertiary-fixed-dim: #e0e0e0;
    on-tertiary: #000000;
    on-tertiary-fixed: #000000;
    on-tertiary-fixed-variant: #000000;
    tertiary-container: #e0e0e0;
    on-tertiary-container: #000000;
    error: #a0a0a0;
    on-error: #000000;
    error-container: #80808080;
    on-error-container: #000000;
    surface: #000000ff;
    on-surface: #ffffff;
    on-surface-variant: #a0a0a0;
    outline: #c0c0c0;
    outline-variant: #3a3a3a;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #5a5a5a;
    inverse-on-surface: #ffffff;
    inverse-primary: #d0d0d0;
    surface-dim: #00000066;
    surface-bright: #3a3a3a66;
    surface-container-lowest: #0000004D;
    surface-container-low: #0505054D;
    surface-container: #1a1a1a4D;
    surface-container-high: #2a2a2a4D;
    surface-container-highest: #3a3a3a4D;
}

